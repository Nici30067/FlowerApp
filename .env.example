# Copy to .env and source it manually; the application never evaluates .env files.
#
# These variables configure the LOCAL server (travel_agent.cli serve, scripts/serve_*.sh). Inside a Flower run
# (`flwr run`, Flower Chat, SuperGrid or a local SuperLink) there are no environment variables: the AgentApp reads the
# run-config keys declared in pyproject.toml instead, and the model credentials are injected by Flower (FLWR_RUNTIME_*).
# Data-provider mapping (ProviderSettings.from_env versus ProviderSettings.from_run_config in travel_agent/settings.py);
# an empty run-config string means the default shown next to the variable below:
#   TRAVEL_DATA_MODE             -> travel.data-mode              (default "live" inside a Flower run, "fixture" here)
#   TRAVEL_CONTACT               -> travel.contact                (default: the app's own contact string; replace it)
#   TRAVEL_ALLOW_PUBLIC_OVERPASS -> travel.allow-public-overpass  (default true inside a Flower run, false here)
#   TRAVEL_ROUTER                -> travel.router                 (default "osrm")
#   OSRM_URL_TEMPLATE            -> travel.osrm-url-template
#   TRAVEL_OVERPASS_URL          -> travel.overpass-url
#   ORS_BASE_URL                 -> travel.ors-url
#   ORS_API_KEY                  -> travel.ors-api-key            (never put a key into published defaults)
#   OPEN_METEO_URL               -> travel.weather-url
#   GEOCODER_URL                 -> travel.geocoder-url
# Model knobs map to agent.* keys (agent.model, agent.max-tool-turns, agent.reasoning-effort, agent.model-timeout-s,
# agent.wall-time-s, agent.max-model-calls, agent.max-output-tokens). Override per run with
# `uv run flwr run . supergrid --run-config 'travel.data-mode="fixture" agent.model="openai/gpt-5.6-sol"' --stream`.
TRAVEL_DATA_MODE=fixture
TRAVEL_AGENT_MODE=rules
# local  = plan in this process (rules or a local model endpoint)
# flower = plan on Flower SuperGrid as a Flower AgentApp (see TRAVEL_FLOWER_* below)
TRAVEL_EXECUTION_BACKEND=local
TRAVEL_DB=runtime/travel.sqlite3
TRAVEL_HOST=127.0.0.1
TRAVEL_PORT=8000
# Set a strong token before exposing the API beyond your machine.
TRAVEL_API_TOKEN=
# OSM tiles are enabled only after pressing "Load OSM map" in the browser.
TRAVEL_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Live service access is explicit. Set your public contact information (e-mail address or URL); it is sent as
# User-Agent: OSMTravelCompanion/0.2 (<contact>) with every live request.
TRAVEL_CONTACT=
TRAVEL_ALLOW_PUBLIC_OVERPASS=false
TRAVEL_OVERPASS_URL=https://overpass-api.de/api/interpreter
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Router for live trips. osrm = public FOSSGIS OSRM instance (no key; foot and bike profiles), ors = OpenRouteService
# (requires ORS_API_KEY). Empty = ors when ORS_API_KEY is set, otherwise osrm. Reported by /api/config as "router".
TRAVEL_ROUTER=
# OSRM endpoint template (HTTPS). {profile} becomes foot or bike and {service} table or route; the app appends /{coords}.
OSRM_URL_TEMPLATE=https://routing.openstreetmap.de/routed-{profile}/{service}/v1/driving
# Place-name lookup behind the City box (GET /api/geocode) and the conversational intake; Open-Meteo geocoding, no key.
# Available in every data mode; in fixture mode only places within 10 km of central Berlin can be planned.
GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Flower SuperGrid backend (TRAVEL_EXECUTION_BACKEND=flower) ---
# control = this server submits runs through the Flower Control API and reads run events (default, no tunnel)
# bridge  = a SuperGrid worker calls back into TRAVEL_PUBLIC_URL with a scoped job credential (legacy)
TRAVEL_FLOWER_MODE=control
# Name of the SuperLink connection in ~/.flwr/config.toml; log in first with `uv run flwr login supergrid`.
TRAVEL_FLOWER_CONNECTION=supergrid
# Empty = the account default federation, e.g. @your-name/workspace.
TRAVEL_FLOWER_FEDERATION=
# Runtime model ID. Flower Endeavor 1.0 is "flower-endeavor-v1.0"; "openai/gpt-5.6-sol" is the fallback.
TRAVEL_MODEL=flower-endeavor-v1.0
# --- Budget of one planning step (shared by SuperGrid runs and the local model mode below) ---
# Evidence tool rounds per specialist. 0 = one bounded model call per specialist (fastest and cheapest).
TRAVEL_MAX_TOOL_TURNS=0
# Responses API reasoning effort: minimal, low, medium, high, xhigh. Empty omits the field (chat endpoints).
TRAVEL_REASONING_EFFORT=low
# Seconds per model call.
TRAVEL_MODEL_TIMEOUT_S=120
# Hard cap on model calls per planning step (default 0). 0 = auto: 5 x (TRAVEL_MAX_TOOL_TURNS + 2), so 10 calls
# with no tool turns. SuperGrid credits are charged per call and token.
TRAVEL_MAX_MODEL_CALLS=0
# Wall-time budget of one planning step in seconds (default 900), enforced by the AgentApp itself.
TRAVEL_WALL_TIME_S=900
# max_output_tokens of every model call (default 2000).
TRAVEL_MAX_OUTPUT_TOKENS=2000
# Local backstop that stops a SuperGrid run. Empty = TRAVEL_WALL_TIME_S + 300, and never below TRAVEL_WALL_TIME_S + 60
# so the AgentApp's own budget fires first and reports a clean failure.
TRAVEL_FLOWER_RUN_TIMEOUT_S=
# Bridge mode only: public HTTPS origin of this server (for example an ngrok URL) plus TRAVEL_API_TOKEN.
TRAVEL_PUBLIC_URL=

# --- Local model mode (TRAVEL_AGENT_MODE=model with TRAVEL_EXECUTION_BACKEND=local) ---
# responses = an OpenAI Responses endpoint (OpenAI, a Flower runtime). chat = a Chat Completions endpoint
# such as Google Gemini's OpenAI-compatible API, adapted by travel_agent/model_adapter.py.
TRAVEL_MODEL_API=responses
TRAVEL_MODEL_BASE_URL=
TRAVEL_MODEL_API_KEY=
# In this mode the chat intake (POST /api/intake) also asks the same model to fill the trip brief (20 s timeout,
# the rules parser is the fallback). With rules, the SuperGrid backend or inside a Flower run the intake stays rules-based.
# Google Gemini example (local development and rehearsal; SuperGrid runs keep using Flower's catalog):
#   TRAVEL_MODEL_API=chat
#   TRAVEL_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   TRAVEL_MODEL=gemini-3.8-flash
#   TRAVEL_MODEL_API_KEY=<your Gemini key>
#   TRAVEL_REASONING_EFFORT=      (leave empty for chat endpoints)
# `scripts/serve_live.sh [port]` (default 8011) runs this Gemini setup on live data: TRAVEL_DATA_MODE=live,
# TRAVEL_ALLOW_PUBLIC_OVERPASS=true, TRAVEL_ROUTER=osrm unless set, TRAVEL_DB=runtime/travel-live.sqlite3.
# It requires GEMINI_API_KEY and TRAVEL_CONTACT.
